# ── Outils dev locaux — non committés (scripts sudo, déploiement local) ───────
dev/

# ── Credentials et secrets — JAMAIS dans le repo (D11.8, ADR-0013) ───────────
.env
.env.*
*.creds
*credentials*.json
*secret*.json
secrets.cfg
*apikey*
*.pem
*.key
*.p12

# Fixtures réelles (hors repo — workspace local Claude Code uniquement)
tests/fixtures/real/
tests/live/fixtures/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.eggs/

# Venv Jeedom (généré par dependancy_install côté box)
resources/venv/

# ── Jeedom runtime (artefacts locaux box) ─────────────────────────────────────
/tmp/
*.pid

# ── Tests / couverture ────────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── MkDocs (build local — déployé via CI) ─────────────────────────────────────
site/

# ── Archives ─────────────────────────────────────────────────────────────────
*.zip
*.tar.gz
.git-deny-patterns

# Zone d'échange SMB (ADR-055) — Sas est un LIEN : /Sas/* seul ne l'attrape pas.
/Sas
/Sas/*

# ── uv : ce projet n'utilise PAS de venv projet ────────────────────────────────
# Les deps runtime du daemon sont posées par Jeedom (system::update → packages.json)
# dans resources/python_venv ; le pyproject.toml est dev-only (ruff/pytest).
# Un uv.lock orphelin est né le 17-06-2026 d'un `uv sync` de reconnaissance de parc,
# annulé le jour même (décision « holmesMcp hors périmètre du venv partagé »).
# Le versionner suggérerait une reproductibilité qui n'existe pas : il ne contient
# ni mcp, ni httpx, ni sqlparse.
uv.lock
.venv/
